+const pluginBalanceTelemetryGUITest = `
+const assert = require('node:assert/strict')
+const vm = require('node:vm')
+const source = require('node:fs').readFileSync(0, 'utf8')
+class Element {
+  constructor(tag, cls='', text='') { this.tag=tag; this.cls=cls; this.textContent=text; this.children=[]; this.attrs={}; this.style={}; this.classList={toggle:()=>true}; }
+  append(...xs) { this.children.push(...xs) }
+  replaceChildren(...xs) { this.children=xs }
+  setAttribute(k,v) { this.attrs[k]=v }
+}
+const now = Date.now()
+const context = vm.createContext({
+  Date, quotaRange:'all', intlLang:()=> 'zh-CN', t:x=>x,
+  el:(tag,cls,text)=>new Element(tag,cls,text),
+  sv:(tag,attrs,style)=>{const e=new Element(tag);e.attrs=attrs||{};e.style=style||{};return e},
+  curveZoom:()=>{}, untilText:at=>String(at), quotaTimeText:()=>'',
+})
+vm.runInContext(source.slice(source.indexOf('function balanceAmount('),source.indexOf('function setQuotaRange(')),context)
+vm.runInContext(source.slice(source.indexOf('function quotaLines('),source.indexOf('// quotaCycleBreak:')),context)
+const find=(e,p)=>e.children?.flatMap(x=>typeof x==='object'?[...(p(x)?[x]:[]),...find(x,p)]:[])||[]
+const card={balance:'15300.125 积分',balanceTelemetry:{amount:15300.125,unit:'积分',kind:'replenishing'},balanceTrend:{points:[{at:new Date(now-3600000).toISOString(),amount:-25.5},{at:new Date(now).toISOString(),amount:15300.125}]}}
+context.card=card
+assert.equal(vm.runInContext('balanceAmount(card,15300.125)',context),'15,300.125 积分')
+assert.equal(vm.runInContext('quotaLines(card).length',context),0)
+let curve=vm.runInContext('balanceCurve(card)',context)
+assert.ok(curve)
+const zero=find(curve,e=>e.attrs['aria-label']==='零余额')[0]
+assert.ok(zero && zero.attrs.y1>0 && zero.attrs.y1<60,'负值零线位于图内')
+const path=find(curve,e=>e.tag==='path')[0]
+assert.ok(path.attrs.d.split('L').length===2,'保留两次实测读数')
+card.balanceTrend.points=card.balanceTrend.points.slice(0,1)
+assert.equal(vm.runInContext('balanceCurve(card)',context),null,'不足两点不显示曲线')
+card.balanceTrend.points.push({at:new Date(now).toISOString(),amount:20})
+card.balanceTrend.fitFrom=new Date(now-3600000).toISOString()
+card.balanceTrend.fitStart=40;card.balanceTrend.fitNow=20;card.balanceTrend.perDay=480
+card.balanceTrend.runsOut=new Date(now+3600000).toISOString()
+card.balanceTelemetry.amount=20
+curve=vm.runInContext('balanceCurve(card)',context)
+assert.ok(find(curve,e=>e.attrs.class==='qc-even bc-fit').length,'保留原生拟合虚线')
+assert.ok(find(curve,e=>String(e.textContent).includes('按近期净下降速度')).length,'预测使用净下降文案')
+card.balanceTelemetry.amount=0
+curve=vm.runInContext('balanceCurve(card)',context)
+assert.ok(find(curve,e=>e.textContent==='当前已耗尽').length)
+assert.equal(find(curve,e=>String(e.textContent).includes('预计')).length,0,'零余额不谎报未来耗尽')
+for (const amounts of [[-1e308,1e308],[1e308,-1e308],[-Number.MAX_VALUE,Number.MAX_VALUE],[0,0],[-Number.MIN_VALUE,Number.MIN_VALUE]]) {
+  card.balanceTelemetry.amount=amounts[1]
+  card.balanceTrend={points:amounts.map((amount,i)=>({at:new Date(now+(i-1)*3600000).toISOString(),amount})),fitFrom:new Date(now-3600000).toISOString(),fitStart:amounts[0],fitNow:amounts[1]}
+  curve=vm.runInContext('balanceCurve(card)',context)
+  const path=find(curve,e=>e.tag==='path')[0]
+  assert.ok(path && !/NaN|Infinity/.test(path.attrs.d),'极端有限余额的折线坐标必须有限')
+  const coords=path.attrs.d.match(/-?\d+(?:\.\d+)?/g).map(Number)
+  assert.equal(coords.length,4)
+  assert.ok(coords.every(Number.isFinite))
+  assert.ok(coords[1]>=0 && coords[1]<=60 && coords[3]>=0 && coords[3]<=60)
+  for (const line of find(curve,e=>e.tag==='line')) {
+    assert.ok(['x1','x2','y1','y2'].every(k=>Number.isFinite(line.attrs[k])),'零线与拟合线坐标必须有限')
+  }
+  if (amounts[0]!==amounts[1]) assert.notEqual(coords[1],coords[3],'极端正负余额不能压成同一条线')
+}
+context.quotaFit={observe:()=>{throw Error('遥测强制换行不得由观察器撤销')}}
+context.quotaText=()=> '原生余额 · 50%'
+context.quotaFill=()=>50
+context.quotaLeft=false
+vm.runInContext(source.slice(source.indexOf('function quotaWindows('),source.indexOf('// Keep the last date')),context)
+card.windows=[{name:'积分余量',used:50,display:'6000 积分（补充基准12000积分） · 300/时，今日已申请'}]
+const windows=vm.runInContext('quotaWindows(card)',context)
+assert.equal(windows.cls,'quota-windows stacked')
+const number=find(windows,e=>e.cls==='quota-n')[0]
+assert.equal(number.children[0].textContent,'余额缺口 50%','百分比必须独立且优先可见')
+assert.equal(number.children[2].textContent,'6000 积分（补充基准12000积分）')
+assert.equal(number.children[4].textContent,'300/时，今日已申请')
+assert.ok(number.title.includes(card.windows[0].display),'完整说明保留在提示中')
+context.quotaRange='off'
+assert.equal(vm.runInContext('balanceCurve(card)',context),null,'沿用原生开关')
+`
