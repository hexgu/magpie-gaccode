+}
+
+const hostBalanceTelemetryTest = `
+const assert = require('node:assert/strict')
+const vm = require('node:vm')
+const source = require('node:fs').readFileSync(0, 'utf8')
+let answer
+const context = vm.createContext({
+  auths: () => new Map([['fixture', {auth:{usage:async()=>answer}}]]),
+  accountKey: () => 'synthetic', readAuth: () => ({synthetic:{type:'api',key:'synthetic'}}),
+  fresh: async()=>{}, info:async()=>({}), inScope:(_,key,fn)=>fn(),
+})
+vm.runInContext(source.slice(source.indexOf('async function usageOf('), source.indexOf('// ---- check-in')), context)
+const check = async b => {
+  answer = {balance:'300/时，说明12000', balanceTelemetry:b}
+  return JSON.parse(JSON.stringify(await vm.runInContext('usageOf("fixture", "synthetic")', context)))
+}
+;(async()=>{
+  for (const b of [undefined,null,{},[],{amount:null,unit:'积分'},{amount:'0',unit:'积分'},{amount:false,unit:'积分'},{amount:NaN,unit:'积分'},{amount:Infinity,unit:'积分'},{amount:0,unit:''},{amount:0,unit:' '},{amount:0,unit:9},{amount:0,unit:'积分',kind:null},{amount:0,unit:'积分',kind:'invalid'}]) {
+    const result = await check(b)
+    assert.ok(!Object.hasOwn(result,'balanceTelemetry'),'未知值不能转为零')
+    assert.equal(result.balance,'300/时，说明12000')
+  }
+  for (const amount of [0,-25.5,15300.125]) {
+    const b = {amount,unit:'积分',kind:'replenishing',refillPerHour:300}
+    assert.deepEqual((await check(b)).balanceTelemetry,b)
+  }
+  for (const rate of [null,-1,'300',NaN,Infinity]) {
+    const b = (await check({amount:1,unit:'积分',kind:'replenishing',refillPerHour:rate})).balanceTelemetry
+    assert.equal(b.amount,1)
+    assert.ok(!Object.hasOwn(b,'refillPerHour'))
+  }
+})().catch(error=>{console.error(error);process.exitCode=1})
