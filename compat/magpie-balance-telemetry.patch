@@ -0,0 +1,265 @@
+package provider
+
+import (
+	"encoding/json"
+	"math"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/plugin"
