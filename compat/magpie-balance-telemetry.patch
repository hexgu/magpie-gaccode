+func TestHostBalanceTelemetry(t *testing.T) {
+	bun, err := exec.LookPath("bun")
+	if err != nil {
+		t.Fatal("限定测试需要 Bun")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, bun, "--no-env-file", "--config=/dev/null", "-e", hostBalanceTelemetryTest)
+	cmd.Stdin = bytes.NewReader(hostJS)
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("host 余额协议失败：%v\n%s", err, out)
