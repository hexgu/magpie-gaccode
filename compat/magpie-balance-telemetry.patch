+func TestPluginBalanceTelemetryGUI(t *testing.T) {
+	bun, err := exec.LookPath("bun")
+	if err != nil {
+		t.Fatal("限定测试需要 Bun")
+	}
+	source, err := os.ReadFile("../gui/assets/app.js")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, bun, "--no-env-file", "--config=/dev/null", "-e", pluginBalanceTelemetryGUITest)
+	cmd.Stdin = bytes.NewReader(source)
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("余额 GUI 契约失败：%v\n%s", err, out)
+	}
+}
