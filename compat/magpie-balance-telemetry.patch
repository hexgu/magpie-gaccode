+	Plan             string            `json:"plan"`
+	Until            string            `json:"until"` // RFC 3339, "" when not told
+	Renew            string            `json:"renew"`
+	Balance          string            `json:"balance"`
+	BalanceTelemetry *BalanceTelemetry `json:"balanceTelemetry,omitempty"`
+	Error            string            `json:"error"`
+	User             string            `json:"user"`
+	SignIn           string            `json:"signIn"` // "expired", "kept", "renewed" or ""
+	Windows          []UsageWindow     `json:"windows"`
+	Resets           *UsageResets      `json:"resets"`
+}
+
+// BalanceTelemetry 是实测剩余余额，与展示文本和路由窗口分开。
+type BalanceTelemetry struct {
+	Amount        *float64 `json:"amount"`
+	Unit          string   `json:"unit"`
+	Kind          string   `json:"kind,omitempty"`
+	RefillPerHour *float64 `json:"refillPerHour,omitempty"`
+}
+
+func (b *BalanceTelemetry) Valid() bool {
+	return b != nil && b.Amount != nil && !math.IsNaN(*b.Amount) && !math.IsInf(*b.Amount, 0) &&
+		strings.TrimSpace(b.Unit) != "" && (b.Kind == "" || b.Kind == "replenishing")
+}
+
+// 可选扩展的格式错误不影响旧 usage，未知余额也不能转换为零。
+func (b *BalanceTelemetry) UnmarshalJSON(data []byte) error {
+	*b = BalanceTelemetry{}
+	var raw struct {
+		Amount        json.RawMessage `json:"amount"`
+		Unit          string          `json:"unit"`
+		Kind          string          `json:"kind"`
+		RefillPerHour json.RawMessage `json:"refillPerHour"`
+	}
+	if json.Unmarshal(data, &raw) != nil {
+		return nil
+	}
+	var amount *float64
+	if json.Unmarshal(raw.Amount, &amount) != nil || amount == nil {
+		return nil
+	}
+	n := BalanceTelemetry{Amount: amount, Unit: strings.TrimSpace(raw.Unit), Kind: raw.Kind}
+	if !n.Valid() {
+		return nil
+	}
+	var rate *float64
+	if json.Unmarshal(raw.RefillPerHour, &rate) == nil && rate != nil && *rate >= 0 && !math.IsNaN(*rate) && !math.IsInf(*rate, 0) {
+		n.RefillPerHour = rate
+	}
+	*b = n
+	return nil
 }
 
