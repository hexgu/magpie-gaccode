+
+func telemetryTestHome(t *testing.T) {
+	t.Helper()
+	home := t.TempDir()
+	testenv.SetHome(t, home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+}
+
+func telemetryTestQuota(t *testing.T, value string) SubscriptionQuota {
+	t.Helper()
+	var u plugin.Usage
+	if err := json.Unmarshal([]byte(`{"balance":"300/时，说明12000","balanceTelemetry":`+value+`}`), &u); err != nil {
+		t.Fatal(err)
+	}
+	return quotaOfPlugin(SubscriptionQuota{Provider: "gaccode", User: "website@example.invalid"}, u)
+}
+
+func TestPluginBalanceTelemetryRejectsUnknown(t *testing.T) {
+	telemetryTestHome(t)
+	for _, raw := range []string{`null`, `{}`, `{"amount":null,"unit":"积分"}`, `{"amount":"0","unit":"积分"}`, `{"amount":false,"unit":"积分"}`, `{"amount":[],"unit":"积分"}`, `{"amount":{},"unit":"积分"}`, `{"amount":1e999,"unit":"积分"}`, `{"amount":0,"unit":""}`, `{"amount":0,"unit":"  "}`, `{"amount":0,"unit":12}`, `{"amount":0,"unit":"积分","kind":"invalid"}`, `[]`, `"invalid"`} {
+		t.Run(raw, func(t *testing.T) {
+			q := telemetryTestQuota(t, raw)
+			if q.BalanceTelemetry != nil {
+				t.Fatalf("未知余额不得成为零：%+v", q.BalanceTelemetry)
+			}
+			notePluginBalanceHistory([]SubscriptionQuota{q}, time.Now())
+			if _, err := os.Stat(balanceHistPath()); !os.IsNotExist(err) {
+				t.Fatalf("不得从说明文字回退采数：%v", err)
+			}
+		})
+	}
+	var missing plugin.Usage
+	if err := json.Unmarshal([]byte(`{"balance":"999积分"}`), &missing); err != nil {
+		t.Fatal(err)
+	}
+	notePluginBalanceHistory([]SubscriptionQuota{quotaOfPlugin(SubscriptionQuota{Provider: "gaccode"}, missing)}, time.Now())
+	if _, err := os.Stat(balanceHistPath()); !os.IsNotExist(err) {
+		t.Fatal("缺少 telemetry 时不得采样余额文本")
+	}
+}
+
+func TestPluginBalanceTelemetryRecordsAndSeparates(t *testing.T) {
+	telemetryTestHome(t)
+	now := time.Now().UTC().Truncate(time.Second)
+	var last []SubscriptionQuota
+	for i, raw := range []string{
+		`{"amount":15000.125,"unit":"积分","kind":"replenishing","refillPerHour":300}`,
+		`{"amount":15300.125,"unit":"积分","kind":"replenishing","refillPerHour":300}`,
+		`{"amount":0,"unit":"积分","kind":"replenishing"}`,
+		`{"amount":-25.5,"unit":"积分","kind":"replenishing"}`,
+	} {
+		q := telemetryTestQuota(t, raw)
+		at := now.Add(time.Duration(i-3) * time.Minute)
+		q.ReadAt = &at
+		last = []SubscriptionQuota{q}
+		noteHistory(last, now)
+	}
+	pts := readBalanceHist()[telemetryHistKey(last[0])]
+	if len(pts) != 4 || pts[0].Amount != 15000.125 || pts[1].Amount != 15300.125 || pts[2].Amount != 0 || pts[3].Amount != -25.5 {
+		t.Fatalf("必须保留每次绝对值读数：%+v", pts)
+	}
+	if last[0].BalanceTrend == nil || last[0].BalanceTrend.RunsOut != nil || last[0].BalanceTrend.Unit != "积分" {
+		t.Fatalf("透支曲线不得预测未来耗尽：%+v", last[0].BalanceTrend)
+	}
+	// 相同 ReadAt、失败及旧读数都不得新增历史点。
+	for _, mode := range []string{"cached", "failed", "stale"} {
+		q := last[0]
+		if mode == "failed" {
+			q.Error = "合成错误"
+		}
+		if mode == "stale" {
+			q.AsOf = &now
+		}
+		notePluginBalanceHistory([]SubscriptionQuota{q}, now.Add(time.Minute))
+	}
+	if got := len(readBalanceHist()[telemetryHistKey(last[0])]); got != 4 {
+		t.Fatalf("重复采样：%d", got)
+	}
+	for _, field := range []string{"provider", "user", "unit", "kind"} {
+		q := telemetryTestQuota(t, `{"amount":9,"unit":"积分","kind":"replenishing"}`)
+		switch field {
+		case "provider":
+			q.Provider = "other"
+		case "user":
+			q.User = "key@example.invalid"
+		case "unit":
+			q.BalanceTelemetry.Unit = "USD"
+		case "kind":
+			q.BalanceTelemetry.Kind = ""
+		}
+		notePluginBalanceHistory([]SubscriptionQuota{q}, now)
+		if len(readBalanceHist()[telemetryHistKey(q)]) != 1 {
+			t.Fatalf("%s 曲线被合并", field)
+		}
+	}
+	card := last[0]
+	card.BalanceTrend = nil
+	got := withAccountReadings([]SubscriptionQuota{card})
+	if len(got) != 1 || got[0].BalanceTrend == nil || len(got[0].BalanceTrend.Points) != 4 {
+		t.Fatalf("缓存卡片丢失历史：%+v", got)
+	}
+}
+
+func TestPluginBalanceTelemetryNetForecast(t *testing.T) {
+	telemetryTestHome(t)
+	now := time.Now().UTC().Truncate(time.Second)
+	for _, tc := range []struct {
+		name    string
+		amounts []float64
+		step    time.Duration
+		predict bool
+	}{
+		{"净下降", []float64{13000, 12400, 11800}, time.Hour, true},
+		{"平", []float64{1000, 1000, 1000}, time.Hour, false},
+		{"下降后最新持平", []float64{13000, 12400, 12400}, time.Hour, false},
+		{"涨", []float64{1000, 1300, 1600}, time.Hour, false},
+		{"补充后样本不足", []float64{1000, 900, 12000, 11900}, time.Hour, false},
+		{"跨度不足", []float64{1000, 900, 800}, 20 * time.Minute, false},
+		{"零", []float64{1200, 600, 0}, time.Hour, false},
+		{"透支", []float64{1000, 400, -200}, time.Hour, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var q SubscriptionQuota
+			for i, amount := range tc.amounts {
+				b, _ := json.Marshal(map[string]any{"amount": amount, "unit": "积分", "kind": "replenishing", "refillPerHour": 300})
+				q = telemetryTestQuota(t, string(b))
+				q.User = tc.name
+				at := now.Add(time.Duration(i-len(tc.amounts)+1) * tc.step)
+				q.ReadAt = &at
+				batch := []SubscriptionQuota{q}
+				notePluginBalanceHistory(batch, now)
+				q = batch[0]
+			}
+			tr := q.BalanceTrend
+			if tr == nil || len(tr.Points) != len(tc.amounts) || (tr.RunsOut != nil) != tc.predict {
+				t.Fatalf("净余额预测不符：%+v", tr)
+			}
+			if tc.predict && (math.Abs(tr.PerDay-14400) > 0.01 || math.Abs(tr.RunsOut.Sub(now).Hours()-11800.0/600) > 0.001) {
+				t.Fatalf("不得额外加减小时补充：%+v", tr)
+			}
+		})
+	}
+}
+
+func TestPluginBalanceTelemetryFiniteFit(t *testing.T) {
+	telemetryTestHome(t)
+	now := time.Now().UTC().Truncate(time.Second)
+	var batch []SubscriptionQuota
+	for i, amount := range []float64{1e308, 9e307, 8e307} {
+		b, _ := json.Marshal(map[string]any{"amount": amount, "unit": "积分", "kind": "replenishing"})
+		q := telemetryTestQuota(t, string(b))
+		at := now.Add(time.Duration(i-2) * time.Hour)
+		q.ReadAt = &at
+		batch = []SubscriptionQuota{q}
+		notePluginBalanceHistory(batch, now)
+	}
+	tr := batch[0].BalanceTrend
+	if tr == nil || len(tr.Points) != 3 || tr.Points[0].Amount != 1e308 || tr.FitFrom != nil || tr.RunsOut != nil || tr.PerDay != 0 || tr.FitStart != 0 || tr.FitNow != 0 {
+		t.Fatalf("极端有限余额必须保留点并清除溢出拟合：%+v", tr)
+	}
+	if _, err := json.Marshal(batch); err != nil {
+		t.Fatalf("遥测不得破坏卡片 JSON 编码：%v", err)
+	}
+}
+
+func TestPluginBalanceTelemetryOptionalRate(t *testing.T) {
+	for _, raw := range []string{`null`, `-1`, `"300"`, `false`, `1e999`} {
+		q := telemetryTestQuota(t, `{"amount":0,"unit":"积分","kind":"replenishing","refillPerHour":`+raw+`}`)
+		if !q.BalanceTelemetry.Valid() || *q.BalanceTelemetry.Amount != 0 || q.BalanceTelemetry.RefillPerHour != nil {
+			t.Fatalf("无效补充速率不应丢弃真实零余额或成为零速率：%s，%+v", raw, q.BalanceTelemetry)
+		}
+	}
+	q := telemetryTestQuota(t, `{"amount":15000,"unit":"积分","kind":"replenishing","refillPerHour":0}`)
+	if q.BalanceTelemetry.RefillPerHour == nil || *q.BalanceTelemetry.RefillPerHour != 0 {
+		t.Fatal("真实零补充速率必须保留")
+	}
+}
+
+func TestPluginBalanceTelemetryHistoryRetention(t *testing.T) {
+	telemetryTestHome(t)
+	now := time.Date(2026, 10, 9, 12, 0, 0, 0, time.UTC)
+	kept := 45 * 24 * time.Hour
+	minutes := int(kept / time.Minute)
+	start := now.Add(-kept - time.Minute)
+	pts := make([]BalancePoint, minutes+1)
+	for i := range pts {
+		pts[i] = BalancePoint{At: start.Add(time.Duration(i) * time.Minute), Amount: 100000 - float64(i)}
+	}
+	// 在保留边界附近设置补充、归零和透支，验证裁剪不压缩这些实际读数。
+	for i, amount := range []float64{12000, 12300, 0, -25.5} {
+		pts[i+1].Amount = amount
+	}
+	q := telemetryTestQuota(t, `{"amount":35199,"unit":"积分","kind":"replenishing"}`)
+	q.ReadAt = &now
+	key := telemetryHistKey(q)
+	idle := q
+	idle.User = "idle@example.invalid"
+	idleKey := telemetryHistKey(idle)
+	nativeKey := quotaHistKey("deepseek", "main")
+	native := slices.Clone(pts[1 : balanceHistMax+2])
+	writeBalanceHist(balanceHist{key: pts, idleKey: slices.Clone(pts[1:]), nativeKey: native})
+
+	batch := []SubscriptionQuota{q}
+	notePluginBalanceHistory(batch, now)
+	h := readBalanceHist()
+	want := append(slices.Clone(pts[1:]), BalancePoint{At: now, Amount: 35199})
+	if len(h[key]) != minutes+1 {
+		t.Fatalf("每分钟采样应保留完整 45 天及两端读数：实际 %d 点，预期 %d 点", len(h[key]), minutes+1)
+	}
+	if !slices.Equal(h[key], want) {
+		t.Fatal("45 天边界裁剪必须仅删除过期点，保留补充、零值、负值及最新读数")
+	}
+	if !slices.Equal(h[idleKey], pts[1:]) {
+		t.Fatal("其他账户的有效遥测历史不能因本次写入而被 4000 点上限截断")
+	}
+	if !slices.Equal(h[nativeKey], native[1:]) {
+		t.Fatal("传统 API 余额仍应采用原有 4000 点容量")
+	}
+	tr := batch[0].BalanceTrend
+	if tr == nil || len(tr.Points) != 14*24*60+1 || !tr.Points[0].At.Equal(now.Add(-14*24*time.Hour)) {
+		t.Fatal("走势图应覆盖完整 14 天，不应缩短至约 2.8 天")
+	}
+	if tr.FitFrom == nil || !tr.FitFrom.Equal(now.Add(-7*24*time.Hour)) {
+		t.Fatalf("预计用完时间应采用完整 7 天拟合范围：实际起点 %v", tr.FitFrom)
+	}
+	if math.Abs(tr.PerDay-1440) > 0.01 || tr.RunsOut == nil ||
+		math.Abs(tr.RunsOut.Sub(now).Minutes()-35199) > 0.01 {
+		t.Fatalf("完整历史仍应保留净下降预测：每日 %v，预计用完时间 %v", tr.PerDay, tr.RunsOut)
+	}
+}
+
+func TestPluginBalanceTelemetryHistoryCapacity(t *testing.T) {
+	telemetryTestHome(t)
+	now := time.Date(2026, 10, 9, 12, 0, 0, 0, time.UTC)
+	limit := 45*24*60 + 1
+	q := telemetryTestQuota(t, `{"amount":1,"unit":"积分","kind":"replenishing"}`)
+	q.ReadAt = &now
+	key := telemetryHistKey(q)
+	// 高频手动刷新仍有容量上限；超限只删除最旧点，保留最新实测值。
+	pts := make([]BalancePoint, limit)
+	for i := range pts {
+		pts[i] = BalancePoint{At: now.Add(time.Duration(i-limit) * time.Second), Amount: float64(limit - i + 1)}
+	}
+	writeBalanceHist(balanceHist{key: pts})
+	notePluginBalanceHistory([]SubscriptionQuota{q}, now)
+	want := append(slices.Clone(pts[1:]), BalancePoint{At: now, Amount: 1})
+	got := readBalanceHist()[key]
+	if !slices.Equal(got, want) {
+		t.Fatalf("高频查询超限后应保留最新 %d 个完整读数：实际 %d 个", limit, len(got))
+	}
+}
